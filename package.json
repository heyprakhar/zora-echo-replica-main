{
  "name": "website_the_opera_house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "node server/server.js",
    "start": "node server/server.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server": "node server/server.js",
    "dev-all": "concurrently \"npm run dev\" \"npm run server\"",
    "deploy": "npm run build && npm run start",
    "analyze": "vite-bundle-analyzer",
    "size-check": "npm run build && analyze dist",
    "accessibility": "axe http://localhost:8080",
    "a11y-test": "concurrently \"npm run dev\" \"sleep 5 && axe http://localhost:8080\"",
    "validate-html": "html-validate dist/index.html",
    "validate": "npm run build && npm run validate-html",
    "critical-css": "critical --src dist/index.html --dest dist/index-critical.html --width 1300 --height 900 --minify"
  },
  "keywords": ["opera house", "banquet hall", "wedding venue", "events"],
  "author": "",
  "license": "ISC",
  "description": "The Opera House - Premium Banquet Hall and Event Venue",
